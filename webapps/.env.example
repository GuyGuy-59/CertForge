# CertForge — example environment file
# Copy to .env and adjust the values before starting the stack:
#   cp .env.example .env

# --- Authentication -----------------------------------------------------
# Credentials used to log into the web UI.
ADMIN_USER=admin
# Change this before any deployment.
ADMIN_PASSWORD=changeme

# --- Flask --------------------------------------------------------------
# Secret used to sign session cookies. Generate a random one, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-secret-key-in-production

# --- PKI ----------------------------------------------------------------
# Public base URL embedded in issued certificates for the CRL Distribution
# Point and the AIA / CA Issuers extensions (e.g. https://pki.example.com).
# Leave empty to issue certificates without those extensions.
BASE_URL=

# Data directory inside the container (mapped to ./volumes/pki).
PKI_DATA_DIR=/data
